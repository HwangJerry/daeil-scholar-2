ACCOUNT_ERASURE_WAIT_HOURS=24
ACCOUNT_ERASURE_EXTERNAL_MODE=manual
ACCOUNT_ERASURE_LEGACY_ROOT=/var/www/legacy/files
ACCOUNT_ERASURE_BACKUP_STATUS_PATH=/tmp/ts09-backup-status.json
