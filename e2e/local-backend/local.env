# Synthetic, disposable TS09 configuration. Never add real credentials here.
ENV=test
SERVER_PORT=8080
SHUTDOWN_TIMEOUT=5s
ALLOWED_ORIGIN=http://localhost:18080
ADMIN_ORIGIN=http://127.0.0.1:18080
# Erasure readiness requires HTTPS; this is receipt-link metadata, not a TLS listener.
SITE_BASE_URL=https://localhost:18080
DB_HOST=db
DB_PORT=3306
DB_USER=e2e
DB_PASSWORD=ts09-synthetic-db
DB_NAME=alumni_e2e
DB_MAX_OPEN_CONNS=5
DB_MAX_IDLE_CONNS=2
DB_CONN_MAX_LIFETIME=1m
DB_CONN_MAX_IDLE_TIME=1m
JWT_SECRET=ts09-synthetic-jwt-secret-never-used-outside-local-e2e
JWT_MAX_AGE=24h
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
VISIT_IP_SALT=ts09-synthetic-visit-salt
SMS_PROVIDER=
SMS_SENDER=
SMS_API_KEY=
SMS_USER_ID=
SMS_NCP_ACCESS_KEY=
SMS_NCP_SECRET_KEY=
SMS_NCP_SERVICE_ID=
SMS_REVIEW_TEST_PHONES=01000000002
SMS_REVIEW_TEST_CODE=654321
PRIVACY_CONSENT_VERSION=2026-09-27-test
PRIVACY_CONSENT_ENFORCE=true
PUSH_ENABLED=false
FCM_PROJECT_ID=
FCM_CREDENTIALS_FILE=
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY_FILE=
UPLOAD_BASE_PATH=/var/www/uploads
