# Server
SERVER_PORT=8080
ALLOWED_ORIGIN=http://localhost:8000
SHUTDOWN_TIMEOUT=10s

# Database (MariaDB 10.1)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=alumni
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m
DB_CONN_MAX_IDLE_TIME=3m

# Migration source approval. Export this value in the shell that invokes
# migrate.sh; the runner intentionally snapshots it before loading backend/.env.
# CANONICAL_CANDIDATE_MANIFEST_SHA256=3d771b1a76cced492f019ef200262bc5acd5e678b21e24c5f24d4dc4afc88bcc

# Kakao OAuth
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:8000/api/auth/kakao/callback
KAKAO_ALLOWED_REDIRECT_URIS=http://localhost:8000/api/auth/kakao/callback

# Sign in with Apple (never commit the actual private key)
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_CLIENT_ID=
APPLE_BUNDLE_ID=com.daeil.dflhsafv2
APPLE_ALLOWED_AUDIENCES=com.daeil.dflhsafv2
APPLE_PRIVATE_KEY=
APPLE_PRIVATE_KEY_PATH=
APPLE_CHALLENGE_TTL=5m
APPLE_JWKS_CACHE_TTL=6h
# Base64-encoded 32-byte AES key used to encrypt provider refresh tokens.
SOCIAL_CREDENTIAL_ENCRYPTION_KEY=

# JWT
JWT_SECRET=change-me-in-production
JWT_MAX_AGE=24h
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# File Upload
UPLOAD_BASE_PATH=/var/www/uploads
UPLOAD_LEGACY_PATH=/var/www/legacy/files
UPLOAD_MAX_FILE_SIZE_MB=10

# Go Runtime (production)
# GOMEMLIMIT=80MiB
# GOMAXPROCS=1

# Automatic erasure: trusted processor for Sentry/logs/backups/legacy identifiers.
# Missing configuration leaves requests visibly pending; it never attests success.
ACCOUNT_ERASURE_EXTERNAL_URL=
ACCOUNT_ERASURE_EXTERNAL_TOKEN=
# Dedicated AES-256-GCM archive key: 64 hex characters, kept outside the DB/repository.
DONATION_ARCHIVE_KEY=
# Optional automatic classification for verified Article 51 ledger records.
# Keep disabled until fiscal-year end and separate complete receipt originals are confirmed.
DONATION_LEDGER_RETENTION_CONFIRMED=false
# Operator confirmed 2026-09-07: HappyNanum digital receipts and originals stored there.
DONATION_RECEIPT_ORIGINALS_SEPARATE=true
# Operator confirmed December 31 year end; legal-basis confirmation remains separate.
DONATION_LEDGER_YEAR_END_MONTH=12
DONATION_LEDGER_RETENTION_EVIDENCE=

# Sentry release projects (2026-09-07). Token requires read access to both projects.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=metanoia-lab
SENTRY_IOS_PROJECT=daeil-ios-release
SENTRY_ANDROID_PROJECT=daeil-android-release

# Dedicated 32-byte hex AES key; distinct from JWT and donation archive keys.
# Temporary external-deletion identifiers expire after 10 days; expiry needs operator review.
ACCOUNT_ERASURE_CONTEXT_KEY=

# Verified physical legacy directory for erasure (serving path may be a symlink).
# Production inventory found /var/www/html/upload; verify permissions before enabling.
ACCOUNT_ERASURE_LEGACY_ROOT=/var/www/html/upload

# Account erasure rollout: paused until release configuration and a disposable account are verified.
ACCOUNT_ERASURE_REQUESTS_ENABLED=false
ACCOUNT_ERASURE_WORKER_ENABLED=false
PRIVACY_RETENTION_ENABLED=false
ACCOUNT_ERASURE_TEST_USER_SEQ=0
# Select the existing administrator evidence workflow, or a verified HTTPS processor.
ACCOUNT_ERASURE_EXTERNAL_MODE=manual
# Configure the two distinct private keys declared above before enabling requests/workers.
