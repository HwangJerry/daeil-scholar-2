# Server
SERVER_PORT=8080
ALLOWED_ORIGIN=http://localhost:8000
SHUTDOWN_TIMEOUT=10s

# Database (MariaDB 10.1)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=alumni
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m
DB_CONN_MAX_IDLE_TIME=3m

# Migration source approval. Export this value in the shell that invokes
# migrate.sh; the runner intentionally snapshots it before loading backend/.env.
# CANONICAL_CANDIDATE_MANIFEST_SHA256=55c50aaffcb04743c1b97ff4a4110decadf3246a090f7415400affda536c1f60

# Kakao OAuth
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:8000/api/auth/kakao/callback
KAKAO_ALLOWED_REDIRECT_URIS=http://localhost:8000/api/auth/kakao/callback

# Sign in with Apple (never commit the actual private key)
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_CLIENT_ID=
APPLE_BUNDLE_ID=com.daeil.dflhsafv2
APPLE_ALLOWED_AUDIENCES=com.daeil.dflhsafv2
APPLE_PRIVATE_KEY=
APPLE_PRIVATE_KEY_PATH=
APPLE_CHALLENGE_TTL=5m
APPLE_JWKS_CACHE_TTL=6h
# Base64-encoded 32-byte AES key used to encrypt provider refresh tokens.
SOCIAL_CREDENTIAL_ENCRYPTION_KEY=

# JWT
JWT_SECRET=change-me-in-production
JWT_MAX_AGE=24h
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# File Upload
UPLOAD_BASE_PATH=/var/www/uploads
UPLOAD_LEGACY_PATH=/var/www/legacy/files
UPLOAD_MAX_FILE_SIZE_MB=10

# Go Runtime (production)
# GOMEMLIMIT=80MiB
# GOMAXPROCS=1
