# alumni-backend.env.example — External systemd environment contract.
# Copy outside the repository to /etc/sysconfig/alumni-backend. Use root:root 0600
# or the approved service-readable root:alumni-backend 0640 ownership/mode,
# set every required secret through the production secret-management path,
# and never commit the populated file.

# Server
SERVER_PORT=8080
ALLOWED_ORIGIN=https://example.invalid
SITE_BASE_URL=https://example.invalid
SHUTDOWN_TIMEOUT=10s

# Maintenance write freeze (proof value is never stored; only its SHA-256 digest)
MAINTENANCE_SENTINEL_PATH=/run/alumni/maintenance
MAINTENANCE_SMOKE_PROOF_SHA256=
MAINTENANCE_SMOKE_ALLOWED_PATHS=/api/auth/login,/api/auth/logout
MAINTENANCE_RELEASE_BRIDGE_PATH=/run/alumni/maintenance-release-bridge
MAINTENANCE_RELEASE_PROOF_SHA256=
MAINTENANCE_RELEASE_OWNER_UID=0
MAINTENANCE_RELEASE_DRAIN_TIMEOUT=90s

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m
DB_CONN_MAX_IDLE_TIME=3m

# JWT and social auth
JWT_SECRET=
JWT_MAX_AGE=24h
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=https://example.invalid/api/auth/kakao/callback

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Push providers
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.daeil.dflhsafv2
APNS_PRIVATE_KEY_PATH=
APNS_PRIVATE_KEY=
APNS_ENVIRONMENT=production
APNS_REQUEST_TIMEOUT=5s
FCM_PROJECT_ID=
FCM_CREDENTIALS_FILE=
FCM_CREDENTIALS_JSON=
FCM_REQUEST_TIMEOUT=5s

# Uploads and payment runtime
UPLOAD_BASE_PATH=/var/www/uploads
UPLOAD_LEGACY_PATH=/var/www/legacy/files
UPLOAD_MAX_FILE_SIZE_MB=10
EASYPAY_IMMEDIATELY_MALL_ID=
EASYPAY_PROFILE_MALL_ID=
EASYPAY_GW_URL=
EASYPAY_BIN_BASE=
EASYPAY_RETURN_BASE_URL=https://example.invalid
PG_AUDIT_LOG_PATH=/var/logs/pg/pg-audit.log

# Observability and privacy
DEBUG_AGENT_ENDPOINT=
DEBUG_AGENT_PROJECT=
DEBUG_AGENT_SECRET=
DEBUG_AGENT_ENVIRONMENT=prod
VISIT_IP_SALT=
ENV=prod

# Constrained production host
GOMEMLIMIT=80MiB
GOMAXPROCS=1
