[Unit]
Description=Alumni Backend API
After=network.target mariadb.service

[Service]
Type=simple
User=nobody
WorkingDirectory=/app/backend
ExecStart=/app/backend/server
Restart=on-failure
RestartSec=5
EnvironmentFile=/etc/sysconfig/alumni-backend

OOMScoreAdjust=0
MemoryLimit=120M

StandardOutput=journal
StandardError=journal
SyslogIdentifier=alumni-backend

[Install]
WantedBy=multi-user.target
