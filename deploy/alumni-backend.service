[Unit]
Description=Alumni Backend API
After=network.target mariadb.service

[Service]
Type=simple
User=alumni-backend
Group=alumni-backend
WorkingDirectory=/app/backend
EnvironmentFile=/etc/sysconfig/alumni-backend
ExecStart=/app/backend/server
Restart=on-failure
RestartSec=5

OOMScoreAdjust=0
MemoryLimit=120M

StandardOutput=journal
StandardError=journal
SyslogIdentifier=alumni-backend

[Install]
WantedBy=multi-user.target
